BOOKSTACK_BASE_URL=https://bookstack.bassopaolo.com
BOOKSTACK_TOKEN_ID=your_token_id
BOOKSTACK_TOKEN_SECRET=your_token_secret

# Optional: shown in the site header and <title>
SITE_TITLE=Polimi CS Notes

# Optional: path prefix when published under a sub-path
# (e.g. "/polimi-cs-notes" for https://user.github.io/polimi-cs-notes/).
# Leave empty for a custom-domain or user/org GitHub Pages root.
SITE_BASE_PATH=

# Optional: full canonical site URL (no trailing slash). Used for SEO
# canonical/Open Graph URLs. Leave empty to omit those tags.
# e.g. https://paolobasso99.github.io/polimi-cs-notes
SITE_URL=

# Optional: default <meta name="description"> used on the index and as a
# fallback when a page has no body content.
SITE_DESCRIPTION=Notes from the Computer Science and Engineering Master's at Politecnico di Milano (2021–2023).
